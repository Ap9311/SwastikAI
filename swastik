# ASK SWASTIKAI
# ============================================================
def ask_swastik(prompt):
    """Send prompt with system prompt to llama-server."""
    try:
        full_prompt = f"[INST] {SYSTEM_PROMPT}\n\n{prompt} [/INST]"

        response = requests.post(
            "http://localhost:8080/completion",
            json={"prompt": full_prompt, "n_predict": 200, "temperature": 0.85},
            timeout=60
        )
        if response.status_code == 200:
            data = response.json()
            if "content" in data:
                content = data["content"].strip()
                if content:
                    content = content.replace("[INST]", "").replace("[/INST]", "").strip()
                    if prompt in content:
                        content = content.split(prompt)[-1].strip()
                    if "You are SwastikAI" in content:
                        content = content.split("You are SwastikAI")[0].strip()
                    content = ' '.join(content.split())
                    print(content)
                    return
        print("Please try again.")
    except requests.exceptions.ConnectionError:
        print("Starting engine...")
        if not os.path.exists("/data/data/com.termux/files/home/llama.cpp/build"):
            print("Building engine... This may take a few minutes.")
            os.system("cd ~ && git clone https://github.com/ggerganov/llama.cpp.git 2>/dev/null")
            os.system("cd ~/llama.cpp && mkdir -p build && cd build && cmake -S .. -B . -DCMAKE_BUILD_TYPE=Release -DGGML_CPU=ON && make llama-cli -j2")
            os.system("cd ~/llama.cpp/build && ./bin/llama-server -m " + MODEL + " > /dev/null 2>&1 &")
            time.sleep(5)
            print("Engine ready! Please try again.")
        else:
            os.system(f"cd ~/llama.cpp/build && ./bin/llama-server -m {MODEL} > /dev/null 2>&1 &")
            time.sleep(3)
            print("Please try again.")
    except Exception as e:
        print(f"Error: {e}")

