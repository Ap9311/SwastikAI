# ============================================================
# OLLAMA FUNCTIONS
# ============================================================
def check_ollama():
    return shutil.which("ollama") is not None

def check_server():
    try:
        with urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2) as resp:
            return resp.status == 200
    except:
        return False

def start_server_silent():
    print(f"{YELLOW}>> Starting SwastikAI engine...{RESET}")
    subprocess.run(["pkill", "-f", "ollama serve"], capture_output=True)
    time.sleep(1)

    subprocess.Popen(
        ["ollama", "serve"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL
    )

    for _ in range(20):
        if check_server():
            print(f"{GREEN}>> Engine ready!{RESET}")
            return True
        time.sleep(0.5)

    print(f"{RED}>> Failed to start engine.{RESET}")
    return False

def check_model():
    try:
        with urllib.request.urlopen("http://localhost:11434/api/tags", timeout=2) as resp:
            data = json.loads(resp.read().decode())
            return any(m["name"] == MODEL_NAME for m in data.get("models", []))
    except:
        return False

def create_model():
    if not os.path.exists(MODEL_FILE):
        print(f"{RED}>> Modelfile not found!{RESET}")
        sys.exit(1)

    print(f"{YELLOW}>> Forging SwastikAI...{RESET}")
    try:
        subprocess.run(
            ["ollama", "create", MODEL_NAME, "-f", MODEL_FILE],
            check=True,
            capture_output=True,
            text=True
        )
        print(f"{GREEN}>> SwastikAI forged!{RESET}")
    except subprocess.CalledProcessError as e:
        print(f"{RED}>> Failed: {e.stderr}{RESET}")
        sys.exit(1)

def ask_swastik(prompt):
    try:
        payload = json.dumps({
            "model": MODEL_NAME,
            "prompt": prompt,
            "stream": True
        })

        process = subprocess.Popen(
            ["curl", "-s", "-X", "POST", "http://localhost:11434/api/generate",
             "-H", "Content-Type: application/json",
             "-d", payload],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1
        )

        buffer = ""
        while True:
            chunk = process.stdout.read(1)
            if not chunk:
                break
            buffer += chunk
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                if line.strip():
                    try:
                        data = json.loads(line)
                        if "response" in data:
                            print(data["response"], end="", flush=True)
                        if data.get("done", False):
                            print()
                            return
                    except json.JSONDecodeError:
                        pass
        process.wait()
    except Exception as e:
        print(f"{RED}>> Error: {e}{RESET}")

