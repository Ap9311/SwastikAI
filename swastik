# ============================================================
# MAIN INTERACTIVE LOOP
# ============================================================
def interactive_chat():
    os.system('clear' if os.name == 'posix' else 'cls')
    print_swastik_logo()
    print_footer()

    if not check_server():
        if not start_server_silent():
            print(f"{RED}>> Could not start engine. Exiting.{RESET}")
            sys.exit(1)

    if not check_model():
        create_model()

    print(f"\n{DIM}──────────────────────────────────────────────────────────────{RESET}")
    print(f"{GREEN}>> Welcome, seeker. Ask me anything.{RESET}")
    print(f"{DIM}──────────────────────────────────────────────────────────────{RESET}")

    while True:
        try:
            user_input = input(f"\n{BOLD}{YELLOW}>>> {RESET}").strip()

            if not user_input:
                continue

            if user_input.startswith("/"):
                cmd = user_input.lower()
                if cmd in ("/exit", "/quit"):
                    print(f"{YELLOW}>> Namaste! Until we meet again.{RESET}")
                    break
                elif cmd == "/clear":
                    os.system('clear' if os.name == 'posix' else 'cls')
                    print_swastik_logo()
                    print_footer()
                    continue
                elif cmd == "/help":
                    show_help()
                    continue
                elif cmd == "/about":
                    show_about()
                    continue
                elif cmd == "/creator":
                    print(f"{GREEN}>> Akshat Popat – born 09/03/2011 in Junagadh, Gujarat. Founder of Obsidian (2025).{RESET}")
                    continue
                else:
                    print(f"{RED}>> Unknown command: {cmd}{RESET}")
                    continue

            print(f"{BOLD}{WHITE}{SWASTIK_SMALL} {RESET}", end="", flush=True)
            ask_swastik(user_input)

            print(f"{DIM}──────────────────────────────────────────────────────────────{RESET}")

        except KeyboardInterrupt:
            print(f"\n\n{YELLOW}>> Namaste! Until we meet again.{RESET}")
            break
        except EOFError:
            break

# ============================================================
# ENTRY POINT
# ============================================================
def main():
    if not check_ollama():
        print(f"{RED}>> Ollama not installed!{RESET}")
        print("  Run: curl -fsSL https://ollama.com/install.sh | sh")
        sys.exit(1)

    interactive_chat()

if __name__ == "__main__":
    main()
