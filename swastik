# ============================================================
# MAIN LOOP
# ============================================================
def main():
    os.system('clear' if os.name == 'posix' else 'cls')
    print_logo()
    print_footer()

    # Check if engine exists (silent)
    if not check_ollama():
        print(f"{RED}>> SwastikAI engine not installed.{RESET}")
        print(f"{YELLOW}>> Run: ./setup.sh{RESET}")
        sys.exit(1)

    # Start server if needed (silent)
    if not check_server():
        print(f"{YELLOW}>> Starting SwastikAI engine...{RESET}")
        start_server()

    # Create model if needed (silent)
    if not check_model():
        if not create_model():
            sys.exit(1)

    print(f"\n{DIM}──────────────────────────────────────────────────────────────{RESET}")
    print(f"{GREEN}>> Welcome, seeker. Ask me anything.{RESET}")
    print(f"{DIM}──────────────────────────────────────────────────────────────{RESET}")

    while True:
        try:
            user_input = input(f"\n{BOLD}{YELLOW}You: {RESET}").strip()

            if not user_input:
                continue

            if user_input.startswith("/"):
                cmd = user_input.lower()
                if cmd in ("/exit", "/quit"):
                    print(f"{YELLOW}>> Namaste! Until we meet again.{RESET}")
                    break
                elif cmd == "/clear":
                    os.system('clear' if os.name == 'posix' else 'cls')
                    print_logo()
                    print_footer()
                    continue
                elif cmd == "/help":
                    show_help()
                    continue
                elif cmd == "/about":
                    show_about()
                    continue
                elif cmd == "/creator":
                    print(f"{GREEN}>> Akshat Popat – born 09/03/2011 in Junagadh, Gujarat. Founder of Obsidian (2025).{RESET}")
                    continue
                else:
                    print(f"{RED}>> Unknown command: {cmd}{RESET}")
                    continue

            print(f"{BOLD}{CYAN}SwastikAI: {RESET}", end="", flush=True)
            ask_swastik(user_input)
            print(f"{DIM}──────────────────────────────────────────────────────────────{RESET}")

        except KeyboardInterrupt:
            print(f"\n\n{YELLOW}>> Namaste! Until we meet again.{RESET}")
            break
        except EOFError:
            break

if __name__ == "__main__":
    main()
